# Public values only. These are bundled into the mobile app.
EXPO_PUBLIC_DATA_MODE=mock
# Leave blank until a backend contract is agreed. Never include credentials.
EXPO_PUBLIC_API_BASE_URL=

# Build-time only, Android map rendering. Restrict the key by package name and
# SHA-1 fingerprint. iOS uses Apple Maps and needs no key.
GOOGLE_MAPS_ANDROID_API_KEY=
