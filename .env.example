# Public values only. These are bundled into the mobile app.
EXPO_PUBLIC_DATA_MODE=mock
# Public backend origin, optionally ending in /api/v1; the client applies the prefix once.
# Use a device-reachable HTTP(S) host for development or the deployed HTTPS origin.
# Never include credentials, Supabase keys, or user access tokens.
EXPO_PUBLIC_API_BASE_URL=

# Authentication is independent of DATA_MODE. Demo remains the default.
EXPO_PUBLIC_AUTH_MODE=demo
# For supabase mode, use the SAME project as FastAPI's SUPABASE_URL.
# Public project URL and sb_publishable_ key only; never a service-role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Build-time only, Android map rendering. Restrict the key by package name and
# SHA-1 fingerprint. iOS uses Apple Maps and needs no key.
GOOGLE_MAPS_ANDROID_API_KEY=
